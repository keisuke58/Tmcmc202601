Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Kombinierte", " ", "Liste", " ", "der", " ", "Vektoren", " ", "als", " ", 
    "zus\[ADoubleDot]tzliche", " ", "Spalten"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"alleVektoren", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"monitor1", ",", "monitor2", ",", "monitor3"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alleVektorenT", " ", "=", " ", 
     RowBox[{"Transpose", "[", "alleVektoren", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Erstelle", " ", "einen", " ", "Vektor", " ", "von", " ", "1", " ", "bis",
      " ", "zur", " ", "Anzahl", " ", "der", " ", "Zeilen"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nummerierung", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "alleVektorenT", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
