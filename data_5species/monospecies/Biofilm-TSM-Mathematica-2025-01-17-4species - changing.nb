    RowBox[{
     RowBox[{"F\[UDoubleDot]ge", " ", "den", " ", "Nummerierungs"}], "-", 
     RowBox[{
     "Vektor", " ", "in", " ", "die", " ", "erste", " ", "Spalte", " ", 
      "ein"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"alleVektorenMitNummerierung", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"Prepend", ",", 
       RowBox[{"{", 
        RowBox[{"alleVektorenT", ",", "nummerierung"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spaltennamen", " ", "hinzuf\[UDoubleDot]gen"}], "*)"}], "\n", 
