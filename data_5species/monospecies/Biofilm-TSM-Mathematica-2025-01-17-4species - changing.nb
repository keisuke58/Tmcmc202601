         "\"\<phi4psi4\>\"", ",", "\"\<c\>\"", ",", "\"\<alpha\>\""}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
