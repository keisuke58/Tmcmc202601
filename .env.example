# Slack通知設定
# このファイルを .env にコピーして、実際の値を設定してください
# 
# cp .env.example .env
# その後、.env を編集して実際のWebhook URLを設定

# Slack Webhook方式（推奨）
# https://api.slack.com/apps でWebhook URLを取得
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Bot Token方式（オプション）
# Webhook方式を使う場合は設定不要
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#your-channel

# Gmail通知設定
# Gmailアカウントとアプリパスワードを設定してください
# アプリパスワードの取得方法: https://myaccount.google.com/apppasswords

# 送信先メールアドレス
EMAIL_TO=your-email@gmail.com

# 送信元メールアドレス（Gmailアカウント）
EMAIL_FROM=your-gmail@gmail.com

# Gmail SMTP認証情報
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-password
